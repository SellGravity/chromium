import("//build/config/features.gni")

source_set("policy_manager") {
  sources = [
    "policy_ipc_client.cc",
    "policy_ipc_client.h",
    "policy_preference_syncer.cc",
    "policy_preference_syncer.h",
  ]

  deps = [
    "//base",
    "//chrome/common",
    "//components/prefs",
    "//content/public/browser",
    "//url",
  ]

  public_deps = [ "//base" ]

  # Windows-specific libraries for HTTP client (WinHTTP)
  if (is_win) {
    libs = [
      "advapi32.lib",
      "winhttp.lib",
    ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "policy_preference_syncer_unittest.cc",
  ]

  deps = [
    ":policy_manager",
    "//base",
    "//base/test:test_support",
    "//chrome/common",
    "//components/prefs:test_support",
    "//testing/gtest",
  ]
}
